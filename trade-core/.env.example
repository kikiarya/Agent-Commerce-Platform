# Shared by Docker Compose and scripts/start-service.ps1.
# Copy to .env and replace secrets before starting.

DB_NAME=ecommerce_platform
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password

MQ_USER=demo
MQ_PASSWORD=replace_with_local_rabbitmq_password

# Required by Store login/JWT (>= 32 bytes).
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_bytes

# Local Gradle bootRun defaults (ignored inside Compose app containers).
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional delivery demo tuning.
DELIVERY_LOSS_RATE=0
DELIVERY_STEP_SECONDS=5

# Optional: comma-separated browser origins for Store CORS / WebSocket.
# Compose maps this to APP_CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional JVM heap for Java containers.
JAVA_OPTS=-Xms256m -Xmx512m
