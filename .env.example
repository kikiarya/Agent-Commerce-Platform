# Root env for umbrella `docker compose up` (also used by included trade-core/compose.yaml).
#   cp .env.example .env

DB_NAME=ecommerce_platform
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password

MQ_USER=demo
MQ_PASSWORD=replace_with_local_rabbitmq_password

# Store JWT (>= 32 bytes)
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_bytes

REDIS_HOST=localhost
REDIS_PORT=6379

DELIVERY_LOSS_RATE=0
DELIVERY_STEP_SECONDS=5

# Allow both core debug UI (:3000) and Agent storefront (:3001)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

JAVA_OPTS=-Xms256m -Xmx512m

# --- storefront (umbrella service) ---
STOREFRONT_JWT_SECRET=replace_with_storefront_jwt_secret_demo
TRADE_CORE_DEFAULT_USER_ID=1
TRADE_CORE_SKU_ID_EQUALS_FRONT=true
